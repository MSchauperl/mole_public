    G --> L[Layer Normalization 2]
    L --> M[Output Hidden States]
    
    subgraph "Attention Sub-layer"
        B
        D
        C
        E
    end
    
    subgraph "Feed-Forward Sub-layer"
        F
        H
        I
        J
        K
        G
        L
    end
    
